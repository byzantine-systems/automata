<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <Description>SQLite store for ByzantineSystems.Automata. Embedded, single-file, WAL; requires SQLite 3.38 or later (bundled).</Description>
        <PackageTags>fsharp;statechart;sqlite;embedded;sqlhydra</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <!-- The unit-of-work effect both stores are written in, shared as source rather than as
             a project: it is internal, so each provider compiles its own copy. First, because
             Db.fs builds its primitives and runners on it. -->
        <Compile Include="..\ByzantineSystems.Automata.Storage.Shared\Op.fs" Link="Op.fs" />
        <!-- Db.fs precedes DataSource.fs: the context's resilience is built from the
             driver-failure classifier that lives with the rest of the adapter boundary. -->
        <Compile Include="Db.fs" />
        <Compile Include="DataSource.fs" />
        <Compile Include="Serialization.fs" />
        <Compile Include="SqlResources.fs" />
        <!-- After SqlResources and DataSource: statement handles resolve embedded SQL, and the
             runners take the context. -->
        <Compile Include="Sql.fs" />
        <!-- Generated by `make schema-generate-sqlite` from the migrated schema; never edited by
             hand. Public because SqlHydra cannot generate anything else, and outside the
             supported API for the same reason: it follows the schema, not semver. -->
        <Compile Include="Schema.Generated.fs" />
        <Compile Include="SqliteCommandInbox.fs" />
        <Compile Include="SqliteChartRegistry.fs" />
        <Compile Include="SqliteCommandProcessorStore.fs" />
        <Compile Include="SqliteActionQueue.fs" />
        <Compile Include="Migrator.fs" />
        <!-- After the migrator: boot compares the file with the minimum version it enforces. -->
        <Compile Include="SqliteBoot.fs" />
        <Compile Include="SqliteMachineStore.fs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Numbered and run once. SQLite has no routines, so there is no repeatable tree. -->
        <EmbeddedResource Include="migrations/main/*.sql" />
        <!-- Queries, keyed by SqlResources as sql/<domain>/<operation>.sql. -->
        <EmbeddedResource Include="sql/**/*.sql" />
    </ItemGroup>

    <ItemGroup>
        <!-- The SQL loader and the column readers are internal, and their tests assert the
             embedded keys resolve and the column contracts match the live schema. -->
        <InternalsVisibleTo Include="ByzantineSystems.Automata.Storage.Sqlite.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ByzantineSystems.Automata.Storage\ByzantineSystems.Automata.Storage.fsproj" />
        <!-- Resilience is applied here rather than above the store, because a pipeline reads
             exceptions and this is the last layer that still has them. -->
        <ProjectReference Include="..\ByzantineSystems.Automata.Resilience\ByzantineSystems.Automata.Resilience.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" VersionOverride="10.0.12" />
        <PackageReference Include="dbup-sqlite" VersionOverride="6.0.4" />
        <PackageReference Include="FSharp.SystemTextJson" />
        <PackageReference Include="FsToolkit.ErrorHandling" />
        <PackageReference Include="SqlHydra.Query" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

</Project>
