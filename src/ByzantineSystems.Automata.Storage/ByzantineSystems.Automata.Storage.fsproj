<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <Description>Storage contracts for ByzantineSystems.Automata.</Description>
        <PackageTags>fsharp;statechart;state-machine;storage</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Arguments.fs" />
        <!-- Command.fs precedes Envelope.fs: an envelope carries an AuditContext, which is
             part of what the inbox records, so the inbox's vocabulary is declared first. -->
        <Compile Include="Command.fs" />
        <Compile Include="InternalIdentifiers.fs" />
        <Compile Include="Envelope.fs" />
        <Compile Include="ChartRegistry.fs" />
        <Compile Include="Processing.fs" />
        <Compile Include="Action.fs" />
        <Compile Include="Temporal.fs" />
        <Compile Include="Maintenance.fs" />
        <Compile Include="MachineStore.fs" />
        <Compile Include="Supervision.fs" />
        <!-- Provider-generic store programs interpreted over each provider's row and parameter types. -->
        <Compile Include="StoreProgram.fs" />
        <!-- One codec table per database enumeration, both directions derived from it. -->
        <Compile Include="EnumCodec.fs" />
        <Compile Include="CommandInboxProgram.fs" />
        <Compile Include="ClaimRecovery.fs" />
        <!-- How a leased command ends, shared by the bundled providers' finalize paths. -->
        <Compile Include="Finalize.fs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ByzantineSystems.Automata.Storage.Postgres" />
        <InternalsVisibleTo Include="ByzantineSystems.Automata.Storage.Sqlite" />
        <InternalsVisibleTo Include="ByzantineSystems.Automata.Storage.Tests" />
        <InternalsVisibleTo Include="ByzantineSystems.Automata.Storage.Postgres.Tests" />
        <InternalsVisibleTo Include="ByzantineSystems.Automata.Storage.Sqlite.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ByzantineSystems.Automata.Core\ByzantineSystems.Automata.Core.fsproj" />
    </ItemGroup>

</Project>
