<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <Description>Command processing, action dispatch and machine lifecycle for ByzantineSystems.Automata.</Description>
        <PackageTags>fsharp;statechart;state-machine;runtime</PackageTags>
    </PropertyGroup>

    <!-- Runtime tests exercise actor ordering and eviction through internal seams. Keeping
         the friend declaration here avoids a source file whose only job is assembly metadata. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>ByzantineSystems.Automata.Runtime.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="Draft.fs" />
        <Compile Include="WorkSignals.fs" />
        <Compile Include="ObserverDispatcher.fs" />
        <Compile Include="Completions.fs" />
        <Compile Include="CommandProcessor.fs" />
        <Compile Include="ActionDispatcher.fs" />
        <Compile Include="Machine.fs" />
        <Compile Include="MachineBuilder.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ByzantineSystems.Automata.Core\ByzantineSystems.Automata.Core.fsproj" />
        <ProjectReference Include="..\ByzantineSystems.Automata.Storage\ByzantineSystems.Automata.Storage.fsproj" />
        <ProjectReference Include="..\ByzantineSystems.Automata.Resilience\ByzantineSystems.Automata.Resilience.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FsToolkit.ErrorHandling" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

</Project>
