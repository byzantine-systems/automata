<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <Description>Typed hierarchical statecharts with pure event resolution.</Description>
        <PackageTags>fsharp;statechart;state-machine;hierarchical</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Identifiers.fs" />
        <Compile Include="Transition.fs" />
        <Compile Include="Errors.fs" />
        <Compile Include="Boundary.fs" />
        <Compile Include="Codec.fs" />
        <Compile Include="Rules.fs" />
        <Compile Include="Resolution.fs" />
        <Compile Include="Chart.fs" />
        <Compile Include="ChartBuilder.fs" />
    </ItemGroup>

</Project>
