{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "src": "docs",
        "files": [
          "**/*.md",
          "toc.yml"
        ]
      }
    ],
    "dest": "out/docs",
    "globalMetadata": {
      "_appName": "ByzantineSystems.Automata",
      "_appTitle": "ByzantineSystems.Automata",
      "_enableSearch": true
    },
    "sitemap": {
      "baseUrl": "https://byzantine-systems.github.io/automata/"
    }
  }
}
