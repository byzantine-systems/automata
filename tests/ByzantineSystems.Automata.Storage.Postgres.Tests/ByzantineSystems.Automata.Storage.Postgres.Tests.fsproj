<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestContext.fs" />
        <Compile Include="SqlResourceTests.fs" />
        <Compile Include="SqlTests.fs" />
        <Compile Include="CommandInboxTests.fs" />
        <Compile Include="ChartRegistryTests.fs" />
        <Compile Include="TemporalTests.fs" />
        <Compile Include="TemporalReaderTests.fs" />
        <Compile Include="CorrectionTests.fs" />
        <Compile Include="HistoryTests.fs" />
        <Compile Include="FinalizeTests.fs" />
        <Compile Include="ActionQueueTests.fs" />
        <Compile Include="ProcessorIntegrationTests.fs" />
        <Compile Include="ReplayIntegrationTests.fs" />
        <Compile Include="SchemaContractTests.fs" />
        <Compile Include="MaintenanceTests.fs" />
        <Compile Include="PostgresSupervisionStoreTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" PrivateAssets="all" />
        <PackageReference Include="coverlet.msbuild" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\ByzantineSystems.Automata.Storage.Postgres\ByzantineSystems.Automata.Storage.Postgres.fsproj" />
        <!-- The processor is exercised here rather than in the runtime suite, because what it
             claims to do is only true of a real database. -->
        <ProjectReference Include="..\..\src\ByzantineSystems.Automata.Runtime\ByzantineSystems.Automata.Runtime.fsproj" />
    </ItemGroup>

</Project>
